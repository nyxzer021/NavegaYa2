# Correo de producción
# Copia estas variables a .env y reemplaza los valores con los datos de tu proveedor SMTP.
# En desarrollo puedes mantener MAIL_MAILER=log.
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=notificaciones@tu-dominio.com
MAIL_PASSWORD=TU_CONTRASENA_O_APP_PASSWORD
MAIL_FROM_ADDRESS=notificaciones@tu-dominio.com
MAIL_FROM_NAME="NavegaYA"
