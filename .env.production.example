APP_NAME=NavegaYA
APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio.pe
APP_KEY=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=navegaya
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

MAIL_MAILER=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="NavegaYA"

BACKUPS_ENABLED=true
BACKUP_PG_DUMP_PATH=/usr/bin/pg_dump
BACKUP_KEEP_DAYS=14
OPERATIONS_MAX_FAILED_JOBS=0

# Permanecen desactivados hasta tener credenciales válidas.
PAYMENTS_SANDBOX=false
CULQI_ENABLED=false
CULQI_ENVIRONMENT=production
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
CULQI_WEBHOOK_SECRET=
CULQI_API_URL=https://api.culqi.com/v2

GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="https://tu-dominio.pe/auth/google/callback"
